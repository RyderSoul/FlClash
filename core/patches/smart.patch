+++ b/common/convert/browser.go
@@ -0,0 +1,225 @@
+package convert
+
+import (
+	"github.com/metacubex/http"
+	"github.com/metacubex/randv2"
+)
+
+type BrowserPreset struct {
+	FingerprintName string
+	Headers         http.Header
+}
