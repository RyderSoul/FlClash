+func downloadModel(path string) (err error) {
+	modelUrl := LgbmUrl()
+	if modelUrl == "" {
+		modelUrl = GetModelDownloadURL()
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second*90)
+	defer cancel()
