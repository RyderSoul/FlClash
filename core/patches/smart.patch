+func (s *Smart) dropUnwrapPins(target string) {
+	s.store.DeleteUnwrapResult(s.Name(), s.configName, target)
+	s.store.DeleteUnwrapResult(s.Name(), s.configName, smart.NetScopedTarget(target, true))
+}
